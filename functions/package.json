{
  "name": "enotif-functions",
  "description": "Cloud Functions for eNOTIF: daily reminder scheduler, demand letter generation, payment confirmation emails.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.4",
    "typescript": "^5.5.4"
  },
  "private": true
}
